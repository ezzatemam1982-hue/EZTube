<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="36dp">

    <!-- Drag Handle / Indicator -->
    <View
        android:id="@+id/voice_search_drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_bottom_sheet_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/voice_search_close_btn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cancel"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_search_drag_handle"
        app:tint="?attr/colorOnSurfaceVariant" />

    <!-- Language Badge -->
    <TextView
        android:id="@+id/voice_search_language_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_voice_language_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/voice_search_close_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voice_search_close_btn"
        tools:text="EN" />

    <!-- Ripple Waveform Container -->
    <FrameLayout
        android:id="@+id/voice_search_ripple_container"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_search_close_btn">

        <!-- Live Concentric Ripple Animation -->
        <com.deniscerri.ytdl.ui.views.VoiceRippleView
            android:id="@+id/voice_search_ripple_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Microphone Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/voice_search_mic_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/voice_search"
            app:backgroundTint="?attr/colorPrimary"
            app:elevation="6dp"
            app:fabCustomSize="68dp"
            app:maxImageSize="32dp"
            app:srcCompat="@drawable/ic_mic"
            app:tint="?attr/colorOnPrimary" />

    </FrameLayout>

    <!-- Status Text ("Listening…" / "Tap to speak") -->
    <TextView
        android:id="@+id/voice_search_status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/voice_search_listening"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_search_ripple_container" />

    <!-- Live Spoken Query Text (Partial / Final) -->
    <TextView
        android:id="@+id/voice_search_query_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:minLines="2"
        android:text="@string/voice_search_speak_now"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_search_status_text" />

    <!-- Offline / Error Container -->
    <LinearLayout
        android:id="@+id/voice_search_error_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_search_query_text">

        <TextView
            android:id="@+id/voice_search_error_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            tools:text="@string/voice_search_error_offline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voice_search_retry_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voice_search_retry" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
