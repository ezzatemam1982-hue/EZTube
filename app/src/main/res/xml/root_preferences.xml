<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="appearance"
        app:icon="@drawable/ic_settings"
        android:title="@string/general"/>

    <Preference
        android:key="folders"
        app:icon="@drawable/baseline_folder_24"
        android:title="@string/directories"/>

    <Preference
        android:key="downloading"
        app:icon="@drawable/ic_downloads"
        android:title="@string/downloads"/>

    <Preference
        android:key="processing"
        app:icon="@drawable/baseline_star_half_24"
        android:title="@string/processing"/>

    <Preference
        android:key="advanced"
        app:icon="@drawable/baseline_settings_suggest_24"
        android:title="@string/advanced"/>

    <PreferenceCategory android:title="@string/backup_restore">
        <Preference
            app:icon="@drawable/baseline_save_alt_24"
            app:key="backup"
            android:summary="@string/backup_summary"
            app:title="@string/backup"/>

        <Preference
            app:icon="@drawable/baseline_restore_page_24"
            app:key="restore"
            android:summary="@string/restore_summary"
            app:title="@string/restore"/>

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:isPreferenceVisible="false"
            app:icon="@drawable/ic_clock"
            app:key="automatic_backup"
            android:summary="@string/automatic_backup_summary"
            app:title="@string/automatic_backup" />

        <com.deniscerri.ytdl.ui.more.settings.LtrPathPreference
            app:icon="@drawable/baseline_folder_24"
            android:summary=""
            app:key="backup_path"
            app:title="@string/backup_path" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/storage_and_cache">
        <Preference
            app:icon="@drawable/baseline_delete_24"
            app:key="clear_cache"
            android:summary="@string/settings_clear_cache_empty"
            app:title="@string/settings_clear_cache" />

        <ListPreference
            app:icon="@drawable/ic_clock"
            app:key="auto_clear_cache"
            app:title="@string/auto_clear_cache_title"
            android:entries="@array/auto_clear_cache_entries"
            android:entryValues="@array/auto_clear_cache_values"
            android:defaultValue="size_250mb"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>